## 配置设备平台
### lite: 酷狗概念版, 默认为手机版
platform=''

## 服务端口 (可选)
PORT=''

## HTTP 代理地址 (可选)
KUGOU_API_PROXY=''

## 设备id(可选，建议固定 )
## KUGOU_API_GUID 建议为 uuidv4
## KUGOU_API_DEV 建议长度为 10 位的字符串
## MAC地址
KUGOU_API_GUID=''
KUGOU_API_DEV=''
KUGOU_API_MAC=''
## webglhash 指纹，如:9655615838832711846
## 如果想使用正式的，可以运行 public/sid_edt_generator.html 来获取固定
KUGOU_API_WEBGL=''

## ============================================
## AI 推荐引擎配置（可选，用于智能推荐/歌词分析）
## ============================================
## 是否启用 AI 功能
AI_ENABLED=false
## AI API 地址（兼容 OpenAI 格式的接口，如 https://api.openai.com/v1）
AI_API_URL=
## AI API Key
AI_API_KEY=
## 模型名称（如 gpt-3.5-turbo, qwen-plus, deepseek-chat 等）
AI_MODEL=
## 最大回复 token 数
AI_MAX_TOKENS=512
## 温度参数 (0-1，越高越有创造性)
AI_TEMPERATURE=0.7

## ============================================
## 个性化推荐引擎配置（可选，依赖本地 MySQL，见 recommend_engine.js / module/recommend.js）
## ============================================
MYSQL_HOST=''
MYSQL_PORT='3306'
MYSQL_USER='root'
KUGOU_DB_PASS=''
